    "fast_validation_size": 120,
    "epoch_validation_size": 160,
    "scoring_chunk_size": 12,
    "generation_max_new_tokens": 32,
    "collapse_threshold": 0.5,
    "success_accuracy": 0.25,
    "log_every_steps": 20,
    "save_every_steps": 100,
